{
  "manifest_version": 3,
  "name": "snapDOM Agent Companion (local)",
  "version": "0.5.0",
  "description": "Runs the snapDOM semantic oracle in an isolated content-script world and exposes it only to explicitly allowlisted extension clients. LOCAL USE ONLY.",
  "key": "",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "ids": [
      "fcoeoabgfenejglbffodgkkbkcdhcgfn",
      "caajdlhkjophkdagpdchjbllohjojgml"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
