{
  "name": "@zumer/snapsurf",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Web navigation, page observations and change verification for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "bin": {
    "snapsurf": "./tools/browse.mjs",
    "snapsurf-mcp": "./mcp/server.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./src/plugin.js"
  },
  "files": [
    "src/",
    "vendor/snapdom/LICENSE",
    "vendor/snapdom/README.md",
    "vendor/snapdom/manifest.json",
    "vendor/snapdom/dist/snapdom.mjs",
    "vendor/snapdom/plugins/gif-export.js",
    "vendor/snapdom/plugins/video-export.js",
    "vendor/snapdom/plugins/capture-frames.js",
    "vendor/snapdom/plugins/redact-inputs.js",
    "vendor/snapdom/plugins/privacy-policy.js",
    "vendor/snapdom/plugins/redact-clone.js",
    "tools/browse.mjs",
    "tools/daemon-client.mjs",
    "tools/install-global.mjs",
    "tools/sdk-bundle.mjs",
    "mcp/server.mjs",
    "companion/build.mjs",
    "companion/content.src.js",
    "companion/gate.mjs",
    "companion/gate-client/",
    "companion/manifest.json",
    "companion/worker.js",
    "companion/content.bundle.js",
    "companion/PROMPT-extension.md",
    "skill/SKILL.md",
    "README.md",
    "LICENSE",
    "docs/INTEGRATIONS.md",
    "docs/USAGE.md",
    "docs/PRIVACY.md",
    "docs/RELEASING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "compile": "node companion/build.mjs && npm run build:sensor && npm run build:browser-sdk",
    "test": "npm run test:vendor && node tools/run-bin.mjs vitest run && npm run test:daemon-mcp && npm run test:multisite-manifest && npm run test:sensor-package && npm run test:browser-sdk",
    "test:daemon-mcp": "node --test test/audit-daemon-mcp.test.mjs test/diff-evidence.test.mjs",
    "test:pack": "node companion/build.mjs --check && node tools/package-smoke.mjs",
    "test:install": "node --test test/global-install-smoke.test.mjs",
    "test:lint": "node tools/run-bin.mjs eslint src test tools mcp companion packages/sensor browser-sdk/build.mjs browser-sdk/receipt.js browser-sdk/sensor.js experiment/multisite-pilot.mjs experiment/multisite-review-score.mjs experiment/multisite experiment/client-side-attention.mjs experiment/client-side-egress-v2.mjs experiment/client-side-egress-v2-audit.mjs experiment/client-side-egress-v3.mjs experiment/client-side-egress-v3-audit.mjs experiment/client-side-footprint.mjs experiment/oem-embed-gate.mjs experiment/directed-host-receipt-value.mjs experiment/schema-drift-receipt-value.mjs --ext .js,.mjs",
    "test:bundles": "node companion/build.mjs --check",
    "test:regression": "node tools/run-isolated.mjs npm run test:regression:isolated",
    "test:regression:isolated": "npm run test && npm run test:lint && npm run test:bundles && node experiment/bench-qa.mjs && node experiment/parity.mjs && node experiment/abis-verbs.mjs && npm run test:contract && npm run test:doc-contract && node demo-qa/run-demo.mjs",
    "test:global": "node experiment/abis-verbs.mjs --daemon $HOME/.claude/snapdom-agent/browse.mjs",
    "test:gates": "npm run test:regression && npm run test:adversarial && node companion/gate.mjs && npm run test:pack",
    "test:contract": "node experiment/contract-gates.mjs",
    "test:doc-contract": "node experiment/doc-contract.mjs",
    "test:adversarial": "node tools/run-isolated.mjs node experiment/adversarial-round.mjs",
    "test:multisite-manifest": "node --test test/multisite-manifest.test.mjs",
    "test:sensor-package": "node packages/sensor/build.mjs --check && node --test test/distribution-manifest.test.mjs test/sensor-package.test.mjs",
    "test:browser-sdk": "node browser-sdk/build.mjs --check && node --test test/client-sdk-package.test.mjs",
    "build:sensor": "node packages/sensor/build.mjs",
    "build:browser-sdk": "node browser-sdk/build.mjs",
    "test:client-evidence": "node experiment/client-side-egress-v2-audit.mjs --check && node experiment/client-side-egress-v3-audit.mjs --check",
    "test:oem-embed": "node experiment/oem-embed-gate.mjs",
    "experiment:directed-host-receipt": "node experiment/directed-host-receipt-value.mjs",
    "experiment:schema-drift-receipt": "node experiment/schema-drift-receipt-value.mjs",
    "experiment:multisite:dry": "node experiment/multisite-pilot.mjs --dry",
    "experiment:multisite:pilot": "node tools/run-isolated.mjs node experiment/multisite-pilot.mjs --run",
    "test:cold": "node tools/cold-install.mjs",
    "test:vendor": "node --test test/vendor-runtime.test.mjs",
    "vendor:update": "node tools/update-snapdom-vendor.mjs",
    "bump:dry": "npx @zumerbox/bump -d",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog",
    "build": "npm run compile && npm pack",
    "release:push": "git add CHANGELOG.md && git commit -m \"Bumped version\" && git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@vitest/browser": "3.2.7",
    "@zumer/snapdiff": "0.2.2",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.55.1"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "author": {
    "name": "Juan Martin Muda / zumerlab",
    "url": "https://github.com/zumerlab"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumerlab/SnapSurf.git"
  },
  "homepage": "https://github.com/zumerlab/SnapSurf#readme",
  "bugs": {
    "url": "https://github.com/zumerlab/SnapSurf/issues"
  },
  "keywords": [
    "mcp",
    "browser",
    "agents",
    "dom",
    "diff",
    "playwright"
  ],
  "publishConfig": {
    "access": "public"
  }
}
