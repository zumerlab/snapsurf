/bin/zsh -lc "command -v npx >/dev/null 2>&1 && node --input-type=module -e '
import { chromium } from \"playwright\";
const browser = await chromium.launch({headless:true});
const page = await browser.newPage();
await page.goto(\"file:///Users/martin/GitHub/zumerlab/snapdom-agent/test/fixtures/side-effect-shop.html\");
const observe = async () => page.locator(\"body\").evaluate((body) => {
  const vis = (el) => { const s=getComputedStyle(el), r=el.getBoundingClientRect(); return s.display"'!=="none" && s.visibility!=="hidden" && r.width>0 && r.height>0; };
  return {
    bodyText: body.innerText,
    controls: [...body.querySelectorAll("button,a,input,select,textarea")].filter(vis).map(el => ({tag:el.tagName, text:(el.innerText||el.value||"").trim(), aria:el.getAttribute("aria-label"), disabled:el.disabled||false})),
    visibleTextElements: [...body.querySelectorAll("body *")].filter(el => vis(el) && [...el.children].every(c => !vis(c))).map(el => ({tag:el.tagName,text:(el.innerText||"").trim()})).filter(x=>x.text)
  };
});
const before = await observe();
const card = page.locator("text=Backpack").locator("xpath=ancestor::*[.//button][1]");
const button = card.getByRole("button", {name:"Add to cart"});
if (await button.count() !== 1) throw new Error(`Backpack button count ${await button.count()}`);
await button.click();
const after = await observe();
console.log(JSON.stringify({before,after},null,2));
await browser.close();
